function [d_out,d_err] = dynamic_delta(zu,zdn,Fu,Fdn,Lds,Lss,Nblock,jump,fig_h,Fmeasure)
%UNTITLED6 Summary of this function goes here
%   Detailed explanation goes here

figure(fig_h);
K=600;
lp=50;
lps=1;
Fp=1:0.1:40;
ep=WLC_Caliper(Lds,50,Fp,K,Lss,1);
epL=WLC_ext(Lds,50,Fp,600);


[zu,dzu]=block_average(zu,Nblock);
[Fu,dFu]=block_average(Fu,Nblock);
[zdn,dzdn]=block_average(zdn,Nblock);
[Fdn,dFdn]=block_average(Fdn,Nblock);

dF=diff(Fu);
f=find(dF<=jump);
if ~isempty(f)
fz=f(1)
zu=zu(1:fz);
dzu=dzu(1:fz);
Fu=Fu(1:fz);
end

%%
subplot(1,3,1);

hold off;

c_ul=[0.85,0.33,0.1];
c_l=[0,0.45,0.74];
plot(zu,Fu,'o','DisplayName',"Ramp Up","Color",c_l);
hold on;
plot(zdn,Fdn,'o','DisplayName',"Ramp Down","Color",c_ul);

zu_s=interp1(Fu,zu,Fp);
plot(zu_s,Fp,'DisplayName',"Ramp_Up - Spline",'LineWidth',1,"Color",c_l);

zdn_s=interp1(Fdn,zdn,Fp);
plot(zdn_s,Fp,'DisplayName',"Ramp_Down - Spline",'LineWidth',1,"Color",c_ul);
xlabel("Extension(nm)");
ylabel("Force(pN)");
set(gca,'FontSize',15);

f10=find(Fp==20);
shift=zdn_s(f10)-ep(f10);
ep=ep+shift;
epL=epL+shift;

plot(ep,Fp,"-",'DisplayName',"WLC UnLooped",'LineWidth',2,"Color",c_ul);
plot(epL,Fp,"-",'DisplayName',"WLC Looped Zero Target",'LineWidth',2,"Color",c_l);

subplot(1,3,2);

hold off;
dz_exp=zdn_s-zu_s;
dz_th=ep-epL;
hold off;
plot(Fp,dz_exp,'o','DisplayName',"Experiment");
hold on;
plot(Fp,dz_th,'DisplayName',"Zero Target Delta");
xlabel("Force (pN)");
ylabel("delta (nm)",'LineWidth',2)
set(gca,'FontSize',15);
legend;
subplot(1,3,3);

d=dz_th-dz_exp;
plot(Fp,d,'o');
xlabel("Force (pN)");
ylabel("distance (nm)",'LineWidth',2)
set(gca,'FontSize',15);

fm=find(Fp==Fmeasure);
d_out=mean(d(fm-10:fm+10));
d_err=std(d(fm-10:fm+10));
zu_out=

end



FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Scientific stack (from requirements.txt, minus build-only pyinstaller) + Flask web view.
RUN pip install --no-cache-dir \
    "numpy>=1.26,<3.0" \
    "scipy>=1.11,<2.0" \
    "matplotlib>=3.8,<4.0" \
    "flask>=3.0,<4.0"

WORKDIR /app
